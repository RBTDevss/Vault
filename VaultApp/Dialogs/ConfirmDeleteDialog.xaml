<Window x:Class="VaultApp.Dialogs.ConfirmDeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Delete permanently" Height="330" Width="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#16181D" Foreground="#E8EAED" FontFamily="Segoe UI">
    <Border Margin="20" Background="#1E2128" CornerRadius="14" Padding="24">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Delete the files?" FontSize="17" FontWeight="Bold"/>
            <TextBlock Margin="0,6,0,10" Foreground="#9AA0A8" TextWrapping="Wrap">
                The encrypted blobs will be overwritten (shredded) and deleted. This is IRREVERSIBLE.
            </TextBlock>
            <TextBlock x:Name="PreviewText" Foreground="#9AA0A8" FontSize="12"
                       TextWrapping="Wrap" MaxHeight="90"
                       TextTrimming="CharacterEllipsis"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Width="100" Height="36" Margin="0,0,8,0"
                        Click="Cancel_Click" Style="{StaticResource GhostButton}"/>
                <Button Content="Delete" Width="120" Height="36"
                        Click="Ok_Click" IsDefault="True" Style="{StaticResource DangerButton}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
