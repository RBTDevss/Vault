<Window x:Class="VaultApp.Dialogs.GroupDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Group" Height="380" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#16181D" Foreground="#E8EAED" FontFamily="Segoe UI">
    <Border Margin="20" Background="#1E2128" CornerRadius="14" Padding="22">
        <StackPanel>
            <TextBlock x:Name="TitleText" Text="Group" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Label to organize your files (e.g. Documents, Photos)."
                       Foreground="#9AA0A8" Margin="0,4,0,12" TextWrapping="Wrap"/>
            <TextBox x:Name="GroupBox" Height="36" FontSize="14"
                     Background="#14161B" Foreground="#E8EAED" BorderBrush="#333845"
                     Padding="10,6" />
            <TextBlock Text="Existing groups (click to use):" Foreground="#9AA0A8"
                       FontSize="12" Margin="0,12,0,4"/>
            <ListBox x:Name="ExistingList" Height="100" Background="#14161B"
                     Foreground="#E8EAED" BorderBrush="#333845"
                     SelectionChanged="ExistingList_SelectionChanged"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Cancel" Width="100" Height="36" Margin="0,0,8,0"
                        Click="Cancel_Click" Style="{StaticResource GhostButton}"/>
                <Button Content="Confirm" Width="120" Height="36"
                        Click="Ok_Click" IsDefault="True" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
