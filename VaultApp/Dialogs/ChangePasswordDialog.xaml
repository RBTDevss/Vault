<Window x:Class="VaultApp.Dialogs.ChangePasswordDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Change password" Height="450" Width="440"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="#16181D" Foreground="#E8EAED" FontFamily="Segoe UI">
    <Border Margin="20" Background="#1E2128" CornerRadius="14" Padding="24">
        <StackPanel>
            <TextBlock Text="Change password" FontSize="18" FontWeight="Bold"/>
            <TextBlock Text="Only the master key is re-wrapped: fast, files are not re-encrypted."
                       Foreground="#9AA0A8" TextWrapping="Wrap" Margin="0,4,0,12"/>
            <PasswordBox x:Name="OldBox" Height="36" Margin="0,0,0,8"
                         Background="#14161B" Foreground="#E8EAED" BorderBrush="#333845" Padding="10,6"/>
            <PasswordBox x:Name="NewBox" Height="36" Margin="0,0,0,8"
                         Background="#14161B" Foreground="#E8EAED" BorderBrush="#333845" Padding="10,6"
                         PasswordChanged="NewBox_PasswordChanged"/>
            <PasswordBox x:Name="RepeatBox" Height="36"
                         Background="#14161B" Foreground="#E8EAED" BorderBrush="#333845" Padding="10,6"/>
            <TextBlock x:Name="StrengthLabel" Foreground="#9AA0A8" FontSize="12" Margin="0,10,0,4"/>
            <ProgressBar x:Name="StrengthBar" Height="8" Minimum="0" Maximum="100" Value="0"
                         Background="#14161B" Foreground="#2E9BEE" BorderThickness="0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
                <Button Content="Cancel" Width="100" Height="36" Margin="0,0,8,0"
                        Click="Cancel_Click" Style="{StaticResource GhostButton}"/>
                <Button Content="Change" Width="120" Height="36"
                        Click="Ok_Click" IsDefault="True" Style="{StaticResource PrimaryButton}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
